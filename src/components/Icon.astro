---
interface Props {
  name: 'arrow' | 'arrow-right' | 'check' | 'phone' | 'message' | 'mechanical' | 'panel' | 'code' | 'robot' | 'plus' | 'menu';
  class?: string;
}
const { name, class: className = '' } = Astro.props;
---
<svg class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <><path d="M6 18 18 6M6 6h12v12" /></>}
  {name === 'arrow-right' && <><path d="M4 12h16m-6-6 6 6-6 6" /></>}
  {name === 'check' && <><path d="m5 12 4 4L19 6" /></>}
  {name === 'phone' && <><path d="m8 3 2 5-3 2a15 15 0 0 0 7 7l2-3 5 2v4a1 1 0 0 1-1 1C10 21 3 14 3 4a1 1 0 0 1 1-1h4Z" /></>}
  {name === 'message' && <><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 21l1.8-5.2A8.5 8.5 0 1 1 21 11.5Z" /><path d="M8 11h8m-8 4h5" /></>}
  {name === 'mechanical' && <><circle cx="8" cy="8" r="2.5" /><circle cx="16" cy="15" r="2.5" /><path d="m10 9 4 4M6 10l-3 9h10l2-2M9 5l7-2 4 5-2 2-3-3-4 1M2 22h13" /></>}
  {name === 'panel' && <><rect x="4" y="3" width="16" height="18" rx="1" /><path d="M8 7h8M8 11h3m-3 6h1m3 0h1m3 0h1m-3-7v3m3-3v3" /></>}
  {name === 'code' && <><rect x="2" y="4" width="20" height="15" rx="2" /><path d="m8 9-3 3 3 3m8-6 3 3-3 3m-3-7-2 8M8 22h8m-4-3v3" /></>}
  {name === 'robot' && <><path d="M7 21h10M9 21v-4m6 4v-4M8 17h8M10 14l-4-4m2-3 5 5m2-2 3-5 3 2-3 5M18 3l1-2m1 8 2 1" /><circle cx="6" cy="7" r="3" /><circle cx="14" cy="14" r="3" /></>}
  {name === 'plus' && <><path d="M12 4v16M4 12h16" /></>}
  {name === 'menu' && <><path d="M4 7h16M4 12h16M4 17h16" /></>}
</svg>
