---
import { company } from '../data/company';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer shell">
  <div class="footer-top">
    <a href="/" class="brand-link" aria-label="Linear Automation home"><img src="/images/linear-automation.png" alt="Linear Automation" width="1176" height="416" class="brand-logo" loading="lazy" /></a>
    <p>Developing industry.<br />Building a better tomorrow.</p>
    <nav aria-label="Footer navigation"><a href="/about/">About us</a><a href="/services/">Our expertise</a><a href="/robotics/">Robotics</a><a href="/products/">Products</a><a href="/clients/">Our clients</a><a href="/contact/">Contact</a></nav>
    <a href="#top" class="back-to-top" aria-label="Back to top"><Icon name="arrow" /></a>
  </div>
  <div class="footer-bottom"><p>© {year} {company.name}. All rights reserved.</p><p>In collaboration with {company.partner}.</p></div>
</footer>
