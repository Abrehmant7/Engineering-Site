---
import { company, enquiryLink } from '../data/company';
import Icon from './Icon.astro';
---
<section id="contact" class="contact-section outer-shell" aria-labelledby="contact-title">
  <div class="contact-content">
    <p class="eyebrow"><span class="status-dot"></span> Better production starts with a conversation</p>
    <h2 id="contact-title">What's your next<br /><span>engineering challenge?</span></h2>
    <p>Tell us about your machine, process or idea.<br class="desktop-break" /> Let's find a practical way forward, together.</p>
    <a class="button button-yellow" href={enquiryLink()} target="_blank" rel="noopener noreferrer">Let's talk on WhatsApp <Icon name="arrow" /></a>
  </div>
  <div class="contact-details">
    <div class="contact-symbol" aria-hidden="true"><Icon name="arrow" /></div>
    <div class="contact-phone-block"><span class="eyebrow">Prefer a call?</span><a href={company.phoneHref}>{company.phone} <Icon name="arrow" /></a><a href={company.secondaryPhoneHref}>{company.secondaryPhone} <Icon name="arrow" /></a></div>
    <span class="contact-partner">LINEAR AUTOMATION <span>×</span> PRINCE ENGINEERING WORKS</span>
  </div>
</section>
