---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { company, enquiryLink, services, products, roboticsServices } from '../data/company';
---
<SiteLayout title="Contact & Project Enquiries | Linear Automation" description="Contact Linear Automation and Prince Engineering Works about robot retrofitting, new robot manufacturing, custom machinery, control panels and automation components. Call or prepare a WhatsApp enquiry.">
  <PageHeader eyebrow="Contact" title="Your next challenge." accent="Let’s talk it through." description="An existing robot to retrofit, a new robot to manufacture, custom machinery or the right component. Tell us where you want to start." />
  <section class="contact-page-grid shell" aria-label="Contact the engineering team"><div class="direct-contact"><p class="eyebrow"><span class="section-tick"></span> Speak with the team</p><h2>A conversation.<br />A practical next step.</h2><p class="body-copy">Call either of the numbers below, or start a WhatsApp conversation with Linear Automation.</p><a class="direct-phone" href={company.phoneHref}><span><small>LINEAR AUTOMATION</small>{company.phone}</span><Icon name="arrow" /></a><a class="direct-phone" href={company.secondaryPhoneHref}><span><small>ADDITIONAL CONTACT</small>{company.secondaryPhone}</span><Icon name="arrow" /></a><a class="button button-yellow" href={enquiryLink()} target="_blank" rel="noopener noreferrer">Open WhatsApp<Icon name="message" /></a><div class="contact-preparation"><h3>Helpful things to have ready</h3><p>For a robot retrofit, share the robot model, controller details and component photographs. For a new robot, describe the workpiece, load, reach and available space. Drawings, part numbers and a short process description also help.</p></div></div>
  <div id="enquiry" class="enquiry-panel"><p class="eyebrow">Start your enquiry</p><h2>Tell us what you have in mind.</h2><p class="form-intro">Prepare a message here, then continue to WhatsApp to review and send it.</p><form id="enquiry-form" class="enquiry-form" data-whatsapp={company.whatsapp}><div class="form-field"><label for="enquiry-name">Your name <span>(required)</span></label><input id="enquiry-name" name="name" autocomplete="name" required minlength="2" maxlength="80" placeholder="Your name" /></div><div class="form-field"><label for="enquiry-company">Company <span>(optional)</span></label><input id="enquiry-company" name="company" autocomplete="organization" maxlength="120" placeholder="Company name" /></div><div class="form-field"><label for="enquiry-interest">What would you like to discuss?</label><select id="enquiry-interest" name="interest"><option value="general">General project enquiry</option><optgroup label="Engineering services">{services.map(service => <option value={service.id}>{service.title}</option>)}</optgroup><optgroup label="Robotics projects">{roboticsServices.map(service => <option value={service.interest}>{service.title}</option>)}</optgroup><optgroup label="Products & components">{products.map(product => <option value={product.id}>{product.name}</option>)}</optgroup></select></div><div class="form-field"><label for="enquiry-message">Your requirement <span>(required)</span></label><textarea id="enquiry-message" name="message" rows="5" required minlength="20" maxlength="2000" placeholder="Describe your machine, process, component or idea…"></textarea><small>Please include at least 20 characters.</small></div><button type="submit" class="button button-dark">Prepare WhatsApp enquiry<Icon name="arrow" /></button></form><noscript><style is:inline>.enquiry-form { display: none; }</style><p class="body-copy">Please use the WhatsApp link or phone numbers to share your enquiry directly.</p></noscript><section id="enquiry-preview" class="enquiry-preview" aria-labelledby="preview-title" hidden><h3 id="preview-title">Your message is ready.</h3><p id="enquiry-message-preview"></p><a id="enquiry-continue" class="button button-yellow" href={enquiryLink()} target="_blank" rel="noopener noreferrer">Continue to WhatsApp<Icon name="arrow" /></a><p class="preview-note">You can review the message in WhatsApp before sending it.</p></section></div></section>
</SiteLayout>
<script>
  import '../scripts/enquiry-form';
</script>
